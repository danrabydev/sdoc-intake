# Copy to .env and adjust (never commit .env).

# Host port mapped to the daemon (container always listens on 8765).
SPECFORGE_HOST_PORT=8765

# Upstream git ref cloned at image build time (tag or branch).
SPECFORGE_REF=v0.21.1

# Set to 1 for uvicorn --reload (rebuild image to pick up upstream source changes).
SPECFORGE_DEV=0

# Default project path inside the container (mounted from ./projects).
# Root for docs/CLI; after init, prefer a subfolder. In the web UI, open e.g. /projects/demo
SPECFORGE_PROJECT=/projects

# LLM keys (also configurable per project in .specforge.yaml)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# When using provider: ollama in .specforge.yaml — reach host Ollama from the container:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# (On Linux Docker Compose 2.x, add extra_hosts: host.docker.internal:host-gateway if needed.)
OLLAMA_BASE_URL=
