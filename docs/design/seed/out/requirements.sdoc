KIND: requirement
BASE_UID: A08
VERSION_N: 0
rbac_op: project:grant:revoke
priority: 50
iteration: iter-r0
security.catalog_ref: AC-2
security.verification_note: AC-2/AC-3 revoke path; AU-2/3/12. ASD STIG V6R4 V-222467 / V-222407.
edge: ← satisfies from CAP-RBAC
in_scope_of_contract: Design-2026-10
in_scope_of_contract: Security package
