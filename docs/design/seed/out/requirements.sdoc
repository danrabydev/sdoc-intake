BASE_UID: ARCH-WORKFLOW
VERSION_N: 0
rbac_op: workflow:architecture
priority: 10
iteration: iter-r0
security.catalog_ref: AU-2
security.verification_note: AU-2/3/12 workflow / approval audit.
delivered_by_release: R1-core-ALM
