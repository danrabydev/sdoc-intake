BASE_UID: ARCH-AUTH-AUDIENCE
VERSION_N: 0
rbac_op: auth:token:validate
priority: 5
iteration: iter-r1
security.catalog_ref: SC-23
security.verification_note: SC-23 session authenticity; AC-3 enforcement at each resource server.
