' Reusable sequence fragments for user-action diagrams.
' Requires C4_Sequence_Participants.puml (stable alias names below).
'
' Macros (keep small; compose in action diagrams):
'   RbacCheck(op)           — business-layer permission gate
'   RbacRouteGuard(op)      — UI route guard before navigation/render
'   AuthenticatedCall(method, path) — browser → API with session bearer
'   ClientScopedQuery(method, path)   — API call carrying client scope header/context
'   AuditLog(action, entity)          — structured audit emission
'   SyncWorkItem(direction)           — push/pull hint via business → DevOps
'   HookEval(action_id)     — load WorkflowProfile ActionHooks (ARCH-HOOK-EVAL)
'   GateCheck(gate_id)      — evaluate one gate (skip optional if disabled)
'   HookEffectsAfter(effects) — run effects_after list after mutate
'   ControlNote / ComplianceNote      — see C4_Sequence_Controls.puml
'
' ActionHook pipeline (ARCH-WORKFLOW / ARCH-HOOK-EVAL):
'   RBAC → HookEval → GateCheck* → mutate → HookEffectsAfter → AuditLog
'   Nest under change_set when present. Do NOT copy-paste this pipeline.

!include ./C4_Sequence_Participants.puml
!include ./C4_Sequence_Controls.puml

!if (%not(%variable_exists("$C4_SEQ_MACROS_INCLUDED")))
!$C4_SEQ_MACROS_INCLUDED = "true"

!unquoted procedure RbacCheck($operation)
seqBusiness -> seqRBAC : require **$operation**
alt denied
  seqRBAC --> seqBusiness : 403 forbidden
else allowed
  seqRBAC --> seqBusiness : ok
end
!endprocedure

!unquoted procedure RbacRouteGuard($operation)
seqWebUI -> seqRouteGuard : navigate / render
seqRouteGuard -> seqRouteGuard : check **$operation**
note right of seqRouteGuard
  Guard uses session claims;
  may block route or redirect.
end note
!endprocedure

!unquoted procedure AuthenticatedCall($method, $path)
seqWebUI -> seqAPI : **$method** $path\nAuthorization: Bearer …
seqAPI -> seqAPI : validate session / token
!endprocedure

!unquoted procedure ClientScopedQuery($method, $path)
seqWebUI -> seqAPI : **$method** $path\nX-Client-Scope: {clientId}
note over seqWebUI, seqAPI
  Client Scoped View filters queries
  server-side; never trust client-only filters.
end note
!endprocedure

!unquoted procedure AuditLog($action, $entity)
seqBusiness -> seqAudit : log($action, $entity, actor, clientId?)
seqAudit -> seqOTEL : export audit event (OTLP)
!endprocedure

!unquoted procedure SyncWorkItem($direction)
seqBusiness -> seqAzureDevOps : **$direction** work item fields
seqAzureDevOps --> seqBusiness : ack / payload
!endprocedure

' --- ActionHook / Gate (ARCH-HOOK-EVAL / ARCH-WORKFLOW) ---

!unquoted procedure HookEval($action_id)
seqBusiness -> seqData : load ActionHooks(**$action_id**)\nfrom project WorkflowProfile
seqData -> seqPostgres : SELECT action_hooks, gates,\nrole_bindings, profile switches
seqPostgres --> seqData : rows
seqData --> seqBusiness : gates_before[], effects_after[]
note right of seqBusiness
  **ARCH-HOOK-EVAL:** RBAC → gates_before
  → mutate → effects_after → audit
  (nest under change_set when present)
end note
!endprocedure

!unquoted procedure GateCheck($gate_id)
seqBusiness -> seqBusiness : GateCheck **$gate_id**
alt optional + disabled on profile
  seqBusiness -> seqBusiness : skip gate
else deny (predicate / RoleBinding slot /\nrequired rows missing)
  seqBusiness --> seqAPI : 403/409 gate deny
else pass
  seqBusiness -> seqBusiness : gate ok
end
!endprocedure

!unquoted procedure HookEffectsAfter($effects)
seqBusiness -> seqBusiness : effects_after:\n**$effects**
!endprocedure

!endif
