{
  "name": "@reqalm/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ReqALM platform shell — API, web, MCP, and sync roles in one codebase.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --import ./src/telemetry/register.ts --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node --import ./dist/telemetry/register.js dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./src/test/otel-preload.ts --test 'src/**/*.test.ts'",
    "migrate": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/cli/seed.ts",
    "seed:reset": "tsx --env-file-if-exists=../../.env src/cli/seed-reset.ts",
    "enroll-mfa": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.reqalm/devenv.env src/cli/enroll-mfa.ts",
    "lint": "node -e \"process.exit(0)\"",
    "capture:catalog-screenshots": "node --import tsx scripts/capture-catalog-browse-screenshots.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/otel": "^0.21.1",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^6.1.1",
    "@node-rs/argon2": "^2.2.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-pg": "^0.75.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "fastify": "^5.2.1",
    "jose": "^6.2.12",
    "otpauth": "^9.5.2",
    "pg": "^8.14.1",
    "yaml": "^2.7.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/jsdom": "21.1.7",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.11",
    "jsdom": "26.1.0",
    "puppeteer-core": "24.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.0"
  }
}
