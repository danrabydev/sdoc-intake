{
  "name": "@reqalm/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ReqALM platform shell — API, web, MCP, and sync roles in one codebase.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "migrate": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/cli/seed.ts",
    "enroll-mfa": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.reqalm/devenv.env src/cli/enroll-mfa.ts",
    "lint": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/static": "^8.1.0",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.2.1",
    "jose": "^6.2.12",
    "otpauth": "^9.5.2",
    "pg": "^8.14.1",
    "yaml": "^2.7.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.0"
  }
}
