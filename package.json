{
  "name": "sdoc-intake-repo",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Monorepo for SDoc Intake and future sibling services.",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "nf3": "0.3.17"
    }
  },
  "dependencies": {
    "sdoc-intake": "workspace:*"
  },
  "scripts": {
    "dev": "pnpm --filter sdoc-intake dev",
    "build": "pnpm --filter sdoc-intake build",
    "build:cli": "pnpm --filter sdoc-intake build:cli",
    "publish:cli": "pnpm --filter sdoc-intake publish:cli",
    "build:dev": "pnpm --filter sdoc-intake build:dev",
    "preview": "pnpm --filter sdoc-intake preview",
    "preview:restart": "pnpm --filter sdoc-intake preview:restart",
    "preview:stop": "pnpm --filter sdoc-intake preview:stop",
    "typecheck": "pnpm --filter sdoc-intake typecheck",
    "check:auth": "pnpm --filter sdoc-intake check:auth",
    "test": "pnpm --filter sdoc-intake test",
    "lint": "pnpm --filter sdoc-intake lint",
    "format": "pnpm --filter sdoc-intake format"
  }
}
