# ReqALM developer environment — run `pnpm devenv:init` after clone (generates secrets in .reqalm/devenv.env + updates .env).
# Do not commit real passwords or tokens.

# --- Mode & roles (ARCH-DEPLOY-MINIMAL) ---
REQALM_MODE=development
REQALM_ROLES=api,web,mcp,sync
REQALM_PORT=3000
REQALM_HOST_PORT=3000
REQALM_VERSION=0.1.0-dev

# --- Postgres (peripherals container) — POSTGRES_PASSWORD set by devenv:init ---
POSTGRES_USER=reqalm
POSTGRES_PASSWORD=
POSTGRES_DB=reqalm
POSTGRES_PORT=5432

# Hybrid/native app DSN (requires `docker compose -f docker-compose.yml -f docker-compose.hostports.yml` for host access):
DATABASE_URL=

# --- OpenBao dev KeyProvider (ARCH-DEVENV-KEYS) ---
OPENBAO_PORT=8200
OPENBAO_ADDR=http://127.0.0.1:8200
OPENBAO_TOKEN=
REQALM_OPENBAO_DEV_MARKED=true

# --- Seed (ARCH-DEVENV-SEED) ---
REQALM_SEED_ON_START=true
REQALM_SEED_PATH=docs/design/seed/dogfood.yaml
REQALM_DEV_ACCOUNT_PASSWORD=

# --- Auth profile (ARCH-AUTH-PROFILE) ---
REQALM_AUTH_IDENTITY_MODE=hybrid
REQALM_AUTH_LOCAL_ACCOUNTS=enabled
# Dev default issuer; production requires https REQALM_ISSUER_URL (startup self-check).
REQALM_ISSUER_URL=http://localhost:3000
# Trust X-Forwarded-* only behind a known reverse proxy (default off).
# REQALM_TRUST_PROXY=false
# With REQALM_TRUST_PROXY=true, list the proxy IPs/CIDRs (production refuses blanket trust):
# REQALM_TRUSTED_PROXIES=10.0.0.5

# --- Web session + agent client (set by devenv:init) ---
REQALM_SESSION_SECRET=
REQALM_AGENT_CLIENT_SECRET=

# --- SDoc Intake editor (packages/intake) ---
# SDOC_ROOT=./packages/intake/data
