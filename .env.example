# ReqAML developer environment — run `pnpm devenv:init` after clone (generates secrets in .reqaml/devenv.env + updates .env).
# Do not commit real passwords or tokens.

# --- Mode & roles (ARCH-DEPLOY-MINIMAL) ---
REQAML_MODE=development
REQAML_ROLES=api,web,mcp,sync
REQAML_PORT=3000
REQAML_HOST_PORT=3000
REQAML_VERSION=0.1.0-dev

# --- Postgres (peripherals container) — POSTGRES_PASSWORD set by devenv:init ---
POSTGRES_USER=reqaml
POSTGRES_PASSWORD=
POSTGRES_DB=reqaml
POSTGRES_PORT=5432

# Hybrid/native app DSN (requires `docker compose -f docker-compose.yml -f docker-compose.hostports.yml` for host access):
DATABASE_URL=

# --- OpenBao dev KeyProvider (ARCH-DEVENV-KEYS) ---
OPENBAO_PORT=8200
OPENBAO_ADDR=http://127.0.0.1:8200
OPENBAO_TOKEN=
REQAML_OPENBAO_DEV_MARKED=true

# --- Seed (ARCH-DEVENV-SEED) ---
REQAML_SEED_ON_START=true
REQAML_SEED_PATH=docs/design/seed/dogfood.yaml
REQAML_DEV_ACCOUNT_PASSWORD=

# --- Auth profile (ARCH-AUTH-PROFILE) ---
REQAML_AUTH_IDENTITY_MODE=hybrid
REQAML_AUTH_LOCAL_ACCOUNTS=enabled
# Dev default issuer; production requires https REQAML_ISSUER_URL (startup self-check).
REQAML_ISSUER_URL=http://localhost:3000
# Trust X-Forwarded-* only behind a known reverse proxy (default off).
# REQAML_TRUST_PROXY=false
# With REQAML_TRUST_PROXY=true, list the proxy IPs/CIDRs (production refuses blanket trust):
# REQAML_TRUSTED_PROXIES=10.0.0.5

# --- Web session + agent client (set by devenv:init) ---
REQAML_SESSION_SECRET=
REQAML_AGENT_CLIENT_SECRET=

# --- SDoc Intake editor (packages/intake) ---
# SDOC_ROOT=./packages/intake/data
