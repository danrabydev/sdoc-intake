# ReqAML developer environment (ARCH-DEVENV-SECRETS — safe defaults only; no production secrets).

# --- Mode & roles (ARCH-DEPLOY-MINIMAL) ---
REQAML_MODE=development
REQAML_ROLES=api,web,mcp,sync
REQAML_PORT=3000
REQAML_HOST_PORT=3000
REQAML_VERSION=0.1.0-dev

# --- Postgres (peripherals container) ---
POSTGRES_USER=reqaml
POSTGRES_PASSWORD=reqaml
POSTGRES_DB=reqaml
POSTGRES_PORT=5432

# Hybrid/native app DSN (Compose service hostname `peripherals` when deps are in Docker):
DATABASE_URL=postgresql://reqaml:reqaml@127.0.0.1:5432/reqaml

# --- OpenBao dev KeyProvider (ARCH-DEVENV-KEYS) ---
OPENBAO_PORT=8200
OPENBAO_ADDR=http://127.0.0.1:8200
# Leave empty: Compose reads it from the reqaml-secrets volume, and `pnpm dev:reqaml` (hybrid)
# fetches it from the running peripherals container. Never commit a real token.
OPENBAO_TOKEN=
REQAML_OPENBAO_DEV_MARKED=true

# --- Seed (ARCH-DEVENV-SEED) ---
REQAML_SEED_ON_START=true
REQAML_SEED_PATH=docs/design/seed/dogfood.yaml
# Dev-only password for seeded local accounts (<identity-id>@dev.local). Never set in production.
# Leave empty to have the first seed generate one and print it once in the app/seed log.
REQAML_DEV_ACCOUNT_PASSWORD=

# --- SDoc Intake editor (packages/intake) ---
# SDOC_ROOT=./packages/intake/data
